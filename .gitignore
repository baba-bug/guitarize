# 原曲音频与分轨：仅本地，不入库
songs/*/source/
songs/*/analysis/stems/
songs/*/build/
songs/*/reports/**/snippets/
*.wav
*.mp3
*.m4a
*.flac
*.aac
*.ncm

# 环境与缓存
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
scripts/.setup.log
.superpowers/
*.egg-info/

# 校验色度图（由原曲分轨计算，体积大且可再生）
songs/*/reports/**/plots/

# 人声基频缓存（由人声分轨计算，可再生）
songs/*/analysis/vocal_f0.npz
# 人声基频缓存（由音频计算，可再生）
songs/*/analysis/vocal_f0.npz
